ARG RUBY_VERSION=3.4.12
FROM ruby:${RUBY_VERSION}-slim

WORKDIR /rails

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential chromium chromium-driver default-libmysqlclient-dev fonts-liberation fonts-noto-color-emoji \
      git libvips libheif-plugin-libde265 libyaml-dev pkg-config sqlite3 && \
    rm -rf /var/lib/apt/lists/*

ENV BUNDLE_PATH=/usr/local/bundle

COPY Gemfile Gemfile.lock ./
RUN bundle install && gem install foreman --no-document
