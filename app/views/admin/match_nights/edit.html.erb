<% content_for :title, t('.title', label: @match_night.label) %>

<div class="mx-auto flex max-w-2xl flex-col gap-6">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-extrabold text-dpc-navy"><%= @match_night.label %></h1>
      <p class="text-sm text-gray-500">
        <%= @match_night.played_on.strftime('%b %-d, %Y') %> - <%= @season.name %>
        <% if @match_night.canceled? %>
          <span class="ml-2 text-xs font-bold uppercase text-red-700"><%= t('match_nights.schedule.canceled') %></span>
        <% elsif @played %>
          <span class="ml-2 text-xs font-bold uppercase text-gray-500"><%= @match_night.complete? ? t('.complete') : t('.locked') %></span>
        <% end %>
      </p>
    </div>
    <%= link_to t('.back'), admin_match_nights_path(season: @season), class: 'text-sm text-dpc-navy underline' %>
  </div>

  <section class="flex flex-col gap-3 rounded-md bg-white p-5 shadow-sm">
    <h2 class="font-semibold text-dpc-navy"><%= t('.details') %></h2>
    <%= form_with model: [:admin, @match_night], method: :patch, class: 'flex flex-wrap items-center gap-2' do |form| %>
      <%= form.text_field :label, maxlength: 60, required: true, class: 'form-input', aria: { label: t('.label') } %>
      <% unless @played %>
        <%= form.date_field :played_on, required: true, class: 'form-input', aria: { label: t('.date') } %>
      <% end %>
      <%= form.submit t('.save'), class: 'btn btn-secondary' %>
    <% end %>
  </section>

  <% unless @match_night.canceled? %>
    <section class="flex flex-col gap-3 rounded-md bg-white p-5 shadow-sm">
      <h2 class="font-semibold text-dpc-navy"><%= t('.times') %></h2>
      <div class="flex flex-wrap items-center gap-2">
        <% @match_night.match_slots.each do |slot| %>
          <% time = slot.label %>
          <span class="flex items-center gap-2 rounded-md border border-gray-300 px-2 py-1 text-sm">
            <%= time %>
            <% unless @played %>
              <%= button_to admin_match_night_match_slot_path(@match_night, slot), method: :delete,
                            class: 'text-gray-400 hover:text-red-700',
                            title: t('.remove_time', time: time), aria: { label: t('.remove_time', time: time) },
                            form: { class: 'inline', data: { turbo_confirm: t('.confirm_remove_time', time: time) } } do %>
                <%= render 'shared/icon', name: 'x-mark', class: 'h-4 w-4' %>
              <% end %>
            <% end %>
          </span>
        <% end %>
        <% if @match_night.match_slots.empty? && !@played %>
          <span class="text-sm text-gray-500"><%= t('.no_times') %></span>
        <% end %>
        <% unless @played %>
          <%= form_with scope: :match_slot, url: admin_match_night_match_slots_path(@match_night), class: 'ml-auto flex items-center gap-2' do |slot_form| %>
            <%= slot_form.time_field :starts_at, step: 900, required: true, class: 'form-input',
                                     aria: { label: t('.add_time') } %>
            <%= slot_form.button type: :submit, title: t('.add_time'), aria: { label: t('.add_time') },
                                 class: 'rounded-md border border-gray-300 p-2 text-dpc-navy hover:bg-gray-50' do %>
              <%= render 'shared/icon', name: 'plus', class: 'h-5 w-5' %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </section>

    <section class="flex flex-col gap-3 rounded-md bg-white p-5 shadow-sm">
      <h2 class="font-semibold text-dpc-navy"><%= t('.matchups') %></h2>
      <%= render 'matchups', night: @match_night, played: @played, teams: @teams %>
    </section>
  <% end %>
</div>
