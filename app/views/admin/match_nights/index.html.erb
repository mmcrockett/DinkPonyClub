<% content_for :title, t('.title') %>

<div class="mx-auto flex max-w-2xl flex-col gap-6">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <h1 class="text-2xl font-extrabold text-dpc-navy"><%= t('.title') %></h1>

    <%= render 'shared/admin_season_switcher', url: admin_match_nights_path, season: @season %>
  </div>

  <% if @match_nights.any? %>
    <ul class="flex flex-col gap-2">
      <% @match_nights.each do |night| %>
        <li id="<%= dom_id(night) %>" class="flex flex-col gap-3 rounded-md bg-white px-4 py-3 shadow-sm">
          <div class="flex items-center justify-between gap-3">
            <div class="min-w-0">
              <details class="inline-block align-top">
                <summary class="flex cursor-pointer list-none items-center gap-1">
                  <span class="font-semibold"><%= night.label %></span>
                  <span class="text-gray-400" title="<%= t('.edit') %>">
                    <%= render 'shared/icon', name: 'pencil-square', class: 'h-4 w-4' %>
                    <span class="sr-only"><%= t('.edit') %></span>
                  </span>
                </summary>
                <%= form_with model: [:admin, night], method: :patch, class: 'mt-2 flex flex-wrap items-center gap-2' do |edit_form| %>
                  <%= edit_form.text_field :label, maxlength: 60, required: true, class: 'form-input',
                                           aria: { label: t('.label') } %>
                  <%= edit_form.date_field :played_on, required: true, class: 'form-input',
                                           aria: { label: t('.date') } %>
                  <%= edit_form.submit t('.save'), class: 'btn btn-secondary' %>
                <% end %>
              </details>
              <span class="text-gray-500">- <%= night.played_on.strftime('%b %-d, %Y') %></span>
              <% if night.venue.present? %>
                <span class="text-gray-500">&middot; <%= night.venue %></span>
              <% end %>
              <% if night.playoff? %>
                <span class="ml-2 text-xs font-bold uppercase text-dpc-green"><%= t('match_nights.schedule.playoffs') %></span>
              <% end %>
            </div>
            <% if night.canceled? %>
              <span class="text-xs font-bold uppercase text-red-700"><%= t('match_nights.schedule.canceled') %></span>
            <% else %>
              <%= button_to cancel_admin_match_night_path(night), method: :patch,
                            class: 'rounded-md p-2 text-red-700 hover:bg-red-50',
                            title: t('.cancel_night'), aria: { label: t('.cancel_night') },
                            form: { data: { turbo_confirm: t('.confirm_cancel') } } do %>
                <%= render 'shared/icon', name: 'x-mark', class: 'h-5 w-5' %>
              <% end %>
            <% end %>
          </div>

          <% unless night.canceled? %>
            <div class="flex flex-wrap items-center gap-2 border-t border-gray-100 pt-3">
              <% night.match_slots.each do |slot| %>
                <% time = slot.label %>
                <span class="flex items-center gap-2 rounded-md border border-gray-300 px-2 py-1 text-sm">
                  <%= time %>
                  <%= button_to admin_match_night_match_slot_path(night, slot), method: :delete,
                                class: 'text-gray-400 hover:text-red-700',
                                title: t('.remove_time', time: time), aria: { label: t('.remove_time', time: time) },
                                form: { class: 'inline', data: { turbo_confirm: t('.confirm_remove_time', time: time) } } do %>
                    <%= render 'shared/icon', name: 'x-mark', class: 'h-4 w-4' %>
                  <% end %>
                </span>
              <% end %>
              <% if night.match_slots.empty? %>
                <span class="text-sm text-gray-500"><%= t('.no_times') %></span>
              <% end %>
              <%= form_with scope: :match_slot, url: admin_match_night_match_slots_path(night), class: 'ml-auto flex items-center gap-2' do |slot_form| %>
                <%= slot_form.time_field :starts_at, step: 900, required: true, class: 'form-input',
                                         aria: { label: t('.add_time') } %>
                <%= slot_form.button type: :submit, title: t('.add_time'), aria: { label: t('.add_time') },
                                     class: 'rounded-md border border-gray-300 p-2 text-dpc-navy hover:bg-gray-50' do %>
                  <%= render 'shared/icon', name: 'plus', class: 'h-5 w-5' %>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-gray-500"><%= t('.empty') %></p>
  <% end %>

  <%= form_with model: [:admin, @match_night], url: admin_match_nights_path(season: @season),
                class: 'flex flex-col gap-4' do |form| %>
    <% if @match_night.errors.any? %>
      <div class="rounded-md bg-red-50 px-4 py-3 text-sm text-red-700">
        <ul class="list-disc pl-4">
          <% @match_night.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="flex flex-col gap-4 rounded-md bg-white p-5 shadow-sm">
      <h2 class="font-bold text-dpc-navy"><%= t('.add') %></h2>

      <div class="flex flex-col gap-1">
        <%= form.label :played_on, class: 'text-sm font-semibold text-dpc-navy' %>
        <%= form.date_field :played_on, class: 'form-input' %>
      </div>

      <div class="flex flex-col gap-1">
        <%= form.label :label, class: 'text-sm font-semibold text-dpc-navy' %>
        <%= form.text_field :label, maxlength: 60, class: 'form-input' %>
      </div>

      <div class="flex flex-col gap-1">
        <%= form.label :venue, class: 'text-sm font-semibold text-dpc-navy' %>
        <%= form.text_field :venue, maxlength: 150, class: 'form-input' %>
      </div>

      <div class="flex flex-col gap-1">
        <%= form.label :notes, class: 'text-sm font-semibold text-dpc-navy' %>
        <%= form.text_area :notes, rows: 2, class: 'form-input' %>
      </div>

      <label class="flex items-center gap-2 text-sm text-dpc-navy">
        <%= form.check_box :playoff %>
        <%= t('match_nights.schedule.playoffs') %>
      </label>
    </div>

    <div class="flex items-center justify-end">
      <%= form.submit t('.add'), class: 'btn btn-primary' %>
    </div>
  <% end %>
</div>
