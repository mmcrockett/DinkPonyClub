<% content_for :title, t('.title') %>

<div class="mx-auto flex max-w-2xl flex-col gap-6">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <h1 class="text-2xl font-extrabold text-dpc-navy"><%= t('.title') %></h1>

    <% seasons = Season.chronological.to_a %>
    <% if seasons.size > 1 %>
      <%= form_with url: admin_match_nights_path, method: :get, class: 'flex items-center gap-2' do |form| %>
        <%= form.select :season, seasons.map { |s| [s.name, s.id] }, { selected: @season.id },
                         class: 'rounded-md border border-gray-300 px-3 py-2' %>
        <%= form.submit 'Go', name: nil, class: 'btn bg-dpc-navy text-white' %>
      <% end %>
    <% end %>
  </div>

  <% if @match_nights.any? %>
    <ul class="flex flex-col gap-2">
      <% @match_nights.each do |night| %>
        <li id="<%= dom_id(night) %>" class="flex items-center justify-between gap-3 rounded-md bg-white px-4 py-3 shadow-sm">
          <div class="min-w-0">
            <span class="font-semibold"><%= night.label %></span>
            <span class="text-gray-500">- <%= night.played_on.strftime('%b %-d, %Y') %></span>
            <% if night.venue.present? %>
              <span class="text-gray-500">&middot; <%= night.venue %></span>
            <% end %>
            <% if night.playoff? %>
              <span class="ml-2 text-xs font-bold uppercase text-dpc-green"><%= t('.playoffs') %></span>
            <% end %>
          </div>
          <% if night.canceled? %>
            <span class="text-xs font-bold uppercase text-red-700"><%= t('.canceled') %></span>
          <% else %>
            <%= button_to t('.cancel_night'), admin_match_night_path(night), method: :patch, class: 'btn btn-secondary',
                          form: { data: { turbo_confirm: t('.confirm_cancel') } } %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-gray-500"><%= t('.empty') %></p>
  <% end %>

  <%= form_with model: [:admin, @match_night], url: admin_match_nights_path(season: @season),
                class: 'flex flex-col gap-4' do |form| %>
    <% if @match_night.errors.any? %>
      <div class="rounded-md bg-red-50 px-4 py-3 text-sm text-red-700">
        <ul class="list-disc pl-4">
          <% @match_night.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="flex flex-col gap-4 rounded-md bg-white p-5 shadow-sm">
      <h2 class="font-bold text-dpc-navy"><%= t('.add') %></h2>

      <div class="flex flex-col gap-1">
        <%= form.label :played_on, class: 'text-sm font-semibold text-dpc-navy' %>
        <%= form.date_field :played_on, class: 'form-input' %>
      </div>

      <div class="flex flex-col gap-1">
        <%= form.label :label, class: 'text-sm font-semibold text-dpc-navy' %>
        <%= form.text_field :label, maxlength: 60, class: 'form-input' %>
      </div>

      <div class="flex flex-col gap-1">
        <%= form.label :venue, class: 'text-sm font-semibold text-dpc-navy' %>
        <%= form.text_field :venue, maxlength: 150, class: 'form-input' %>
      </div>

      <div class="flex flex-col gap-1">
        <%= form.label :notes, class: 'text-sm font-semibold text-dpc-navy' %>
        <%= form.text_area :notes, rows: 2, class: 'form-input' %>
      </div>

      <label class="flex items-center gap-2 text-sm text-dpc-navy">
        <%= form.check_box :playoff %>
        <%= t('.playoffs') %>
      </label>
    </div>

    <div class="flex items-center justify-end">
      <%= form.submit t('.add'), class: 'btn btn-primary' %>
    </div>
  <% end %>
</div>
