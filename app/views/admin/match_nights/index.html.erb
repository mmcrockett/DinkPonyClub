<% content_for :title, t('.title') %>

<div class="mx-auto flex max-w-2xl flex-col gap-6">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <h1 class="text-2xl font-extrabold text-dpc-navy"><%= t('.title') %></h1>

    <div class="flex items-center gap-2">
      <%= render 'shared/admin_season_switcher', url: admin_match_nights_path, season: @season %>
      <%= link_to new_admin_match_night_path(season: @season), class: 'btn btn-primary',
                  title: t('.add'), aria: { label: t('.add') } do %>
        <%= render 'shared/icon', name: 'plus', class: 'h-5 w-5' %>
      <% end %>
    </div>
  </div>

  <% if @match_nights.any? %>
    <ul class="flex flex-col gap-2">
      <% @match_nights.each do |night| %>
        <% played = @played_night_ids.include?(night.id) %>
        <li id="<%= dom_id(night) %>" class="flex flex-col gap-3 rounded-md bg-white px-4 py-3 shadow-sm">
          <div class="flex items-center justify-between gap-3">
            <div class="min-w-0">
              <span class="font-semibold"><%= night.label %></span>
              <span class="text-gray-500">- <%= night.played_on.strftime('%b %-d, %Y') %></span>
              <%= link_to edit_admin_match_night_path(night), class: 'ml-1 inline-block align-middle text-gray-400 hover:text-dpc-navy',
                          title: t('.edit'), aria: { label: t('.edit') } do %>
                <%= render 'shared/icon', name: 'pencil-square', class: 'h-4 w-4' %>
              <% end %>
              <% if night.venue.present? %>
                <span class="text-gray-500">&middot; <%= night.venue %></span>
              <% end %>
              <% if night.playoff? %>
                <span class="ml-2 text-xs font-bold uppercase text-dpc-green"><%= t('match_nights.schedule.playoffs') %></span>
              <% end %>
            </div>
            <% if night.canceled? %>
              <span class="text-xs font-bold uppercase text-red-700"><%= t('match_nights.schedule.canceled') %></span>
            <% elsif played %>
              <span class="text-xs font-bold uppercase text-gray-500"><%= (night.complete? ? t('.complete') : t('.locked')) %></span>
            <% else %>
              <%= button_to cancel_admin_match_night_path(night), method: :patch,
                            class: 'rounded-md p-2 text-red-700 hover:bg-red-50',
                            title: t('.cancel_night'), aria: { label: t('.cancel_night') },
                            form: { data: { turbo_confirm: t('.confirm_cancel') } } do %>
                <%= render 'shared/icon', name: 'x-mark', class: 'h-5 w-5' %>
              <% end %>
            <% end %>
          </div>

          <% unless night.canceled? %>
            <div class="flex flex-col gap-1 border-t border-gray-100 pt-3 text-sm">
              <p class="text-gray-500">
                <%= night.match_slots.any? ? night.match_slots.map(&:label).to_sentence : t('.no_times') %>
              </p>
              <% night.matches.each do |match| %>
                <p><%= match.home_team.name %> <span class="text-gray-400"><%= t('.vs') %></span> <%= match.away_team.name %></p>
              <% end %>
              <% if night.matches.empty? %>
                <p class="text-gray-500"><%= t('.no_matchups') %></p>
              <% end %>
            </div>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-gray-500"><%= t('.empty') %></p>
  <% end %>
</div>
