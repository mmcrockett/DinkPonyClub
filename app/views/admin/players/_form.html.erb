<%= form_with model: [:admin, player], class: 'flex flex-col gap-4' do |form| %>
  <% if player.errors.any? %>
    <div class="rounded-md bg-red-50 px-4 py-3 text-sm text-red-700">
      <ul class="list-disc pl-4">
        <% player.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="flex flex-col gap-4 rounded-md bg-white p-5 shadow-sm">
    <div class="flex flex-col gap-1">
      <%= form.label :first_name, class: 'text-sm font-semibold text-dpc-navy' %>
      <%= form.text_field :first_name, class: 'form-input', aria: { invalid: player.errors[:first_name].any? } %>
    </div>

    <div class="flex flex-col gap-1">
      <%= form.label :last_name, class: 'text-sm font-semibold text-dpc-navy' %>
      <%= form.text_field :last_name, class: 'form-input', aria: { invalid: player.errors[:last_name].any? } %>
    </div>

    <div class="flex flex-col gap-1">
      <%= form.label :email, class: 'text-sm font-semibold text-dpc-navy' %>
      <%= form.email_field :email, class: 'form-input', aria: { invalid: player.errors[:email].any? } %>
    </div>

    <div class="flex flex-col gap-1">
      <%= form.label :phone, class: 'text-sm font-semibold text-dpc-navy' %>
      <%= form.telephone_field :phone, class: 'form-input', aria: { invalid: player.errors[:phone].any? } %>
    </div>

    <div class="flex flex-col gap-1">
      <%= form.label :avatar_url, class: 'text-sm font-semibold text-dpc-navy' %>
      <%= form.text_field :avatar_url, class: 'form-input', aria: { invalid: player.errors[:avatar_url].any? } %>
    </div>

    <div class="flex flex-col gap-1">
      <%= form.label :status, class: 'text-sm font-semibold text-dpc-navy' %>
      <% if player == current_player %>
        <p class="text-sm text-dpc-navy/70"><%= t('admin.players.form.own_status', status: player.status) %></p>
      <% else %>
        <%= form.select :status, Player.statuses.keys, {}, class: 'form-input' %>
      <% end %>
    </div>
  </div>

  <div class="flex items-center justify-end gap-3">
    <%= link_to 'Cancel', admin_players_path, class: 'btn btn-secondary' %>
    <%= form.submit class: 'btn btn-primary' %>
  </div>
<% end %>
