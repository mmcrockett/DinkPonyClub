<div class="mx-auto flex max-w-2xl flex-col gap-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-extrabold text-dpc-navy">Players</h1>
    <div class="flex items-center gap-3">
      <%= link_to t('admin.rosters.show.title'), admin_roster_path, class: 'btn btn-secondary' %>
      <%= link_to t('admin.fees.index.title'), admin_fees_path, class: 'btn btn-secondary' %>
      <% if current_season %>
        <%= link_to t('admin.announcements.new.title'), new_admin_announcement_path(season: current_season),
                    class: 'btn btn-secondary' %>
        <%= button_to t('admin.payment_requests.button'), admin_payment_requests_path(season: current_season),
                      class: 'btn btn-secondary',
                      form: { data: { turbo_confirm: t('admin.payment_requests.confirm_all', season: current_season.name) } } %>
      <% end %>
      <%= link_to 'New player', new_admin_player_path, class: 'btn btn-primary' %>
    </div>
  </div>

  <ul class="flex flex-col gap-2">
    <% @players.each do |player| %>
      <li class="flex items-center justify-between rounded-md bg-white px-4 py-3 shadow-sm">
        <div>
          <span class="font-semibold"><%= player.full_name %></span>
          <span class="text-gray-500">- <%= player.email.presence || 'no email' %></span>
          <% unless player.active? %>
            <span class="ml-2 text-xs font-bold uppercase text-red-600"><%= player.status.humanize %></span>
          <% end %>
          <% if player.admin? %>
            <span class="ml-2 text-xs font-bold uppercase text-dpc-green">Admin</span>
          <% end %>
        </div>
        <%= link_to 'Edit', edit_admin_player_path(player), class: 'btn btn-secondary' %>
      </li>
    <% end %>
  </ul>
</div>
