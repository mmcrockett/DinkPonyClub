<% if signed_in? %>
  <div class="flex flex-col gap-6">
    <% if @season&.name == 'Fall 2026' %>
      <%= link_to image_path('fall-2026-lineups.webp'), class: 'block overflow-hidden rounded-lg border border-gray-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-dpc-navy', aria: { label: t('.banner_link') } do %>
        <%= image_tag 'fall-2026-lineups.webp', alt: t('.banner_alt'), width: 1536, height: 1024, class: 'block h-auto w-full', fetchpriority: 'high' %>
      <% end %>
    <% end %>

    <%= render 'match_nights/match_night', match_night: @next_match_night if @next_match_night %>

    <% if @season %>
      <section class="flex flex-col gap-3">
        <div class="flex items-baseline justify-between gap-3">
          <h2 class="text-xl font-extrabold text-dpc-navy"><%= t('.standings', season: @season.name) %></h2>
          <%= link_to t('.full_standings'), season_standings_path(@season), class: 'text-sm font-semibold text-dpc-green hover:underline' %>
        </div>

        <% if @rows.any? %>
          <%= render 'standings/table', rows: @rows, season: @season %>
        <% else %>
          <p class="text-gray-500"><%= t('standings.show.empty') %></p>
        <% end %>
      </section>
    <% end %>
  </div>
<% else %>
  <div class="flex flex-col items-center gap-4 py-12 text-center">
    <h1 class="text-3xl font-extrabold text-dpc-navy"><%= t('.welcome') %></h1>
    <p class="text-gray-500"><%= t('.sign_in_prompt') %></p>
    <%= link_to t('.sign_in'), sign_in_path, class: 'btn btn-primary' %>
  </div>
<% end %>
