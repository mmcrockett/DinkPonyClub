<div class="flex flex-col gap-10">
  <div class="flex flex-col gap-6 items-center">
    <%= image_tag "celebration.gif", alt: "Championship celebration", class: "rounded-lg shadow-lg max-w-md w-full" %>
    <%= image_tag "champs.png", alt: "Dink Pony Club champions", class: "rounded-lg shadow-lg max-w-md w-full" %>
  </div>

  <div>
    <h1 class="text-3xl font-extrabold text-dpc-navy mb-1">Dink Pony Club Playoffs</h1>
    <p class="text-gray-500 mb-6">August 14, 2026</p>

    <div class="grid md:grid-cols-2 gap-6">
      <%= render "bracket_table",
            title: "Semifinal 1",
            left_seed: 1, left_name: "Soft Serves", left_score: 6,
            right_seed: 4, right_name: "Big Dink Energy", right_score: 9,
            header_bg: "bg-dpc-navy", winner_color: "text-dpc-navy",
            rows: semifinal_1_rows,
            footer_text: "Big Dink Energy advances to the Finals" %>

      <%= render "bracket_table",
            title: "Semifinal 2",
            left_seed: 2, left_name: "Net Gainz", left_score: 10,
            right_seed: 3, right_name: "Old Balls, New Flicks", right_score: 4,
            header_bg: "bg-dpc-green", winner_color: "text-dpc-green",
            rows: semifinal_2_rows,
            footer_text: "Net Gainz advances to the Finals" %>
    </div>
  </div>

  <div class="grid md:grid-cols-3 gap-6 items-start">
    <div class="md:col-span-2">
      <%= render "bracket_table",
            title: "Championship Final",
            left_seed: 2, left_name: "Net Gainz", left_score: 6,
            right_seed: 4, right_name: "Big Dink Energy", right_score: 9,
            header_bg: "bg-dpc-green", winner_color: "text-dpc-green",
            rows: final_rows,
            footer_text: nil %>
    </div>

    <div class="border-2 border-black text-center">
      <div class="bg-black text-white font-bold py-2">Champion</div>
      <div class="py-6 px-4">
        <p class="text-xl font-extrabold text-dpc-navy mb-2">#4 Big Dink Energy</p>
        <span class="text-5xl">🏆</span>
      </div>
    </div>
  </div>
</div>
