<div data-controller="sidebar install">
  <div class="sidebar-backdrop fixed inset-0 z-40 bg-black/40"
       data-sidebar-target="backdrop" data-action="click->sidebar#close"></div>

  <aside id="sidebar" class="sidebar fixed inset-y-0 left-0 z-50 flex flex-col overflow-y-auto bg-dpc-navy py-3 text-white"
         data-sidebar-target="panel"
         data-action="keydown.esc@document->sidebar#close">
    <div class="flex items-center gap-2 px-3">
      <button type="button" class="btn touch-target shrink-0" aria-label="Toggle menu"
              aria-expanded="<%= sidebar_expanded? %>" aria-controls="sidebar"
              data-sidebar-target="button" data-action="click->sidebar#toggle">
        <span class="lg:hidden text-2xl leading-none" aria-hidden="true">&#9776;</span>
        <span class="hidden lg:inline-flex">
          <%= render 'shared/icon', name: 'chevron-left', class: 'sidebar-chevron h-6 w-6' %>
        </span>
      </button>

      <%= link_to root_path, class: 'flex min-w-0 items-center gap-2', aria: { label: 'Dink Pony Club' } do %>
        <%= image_tag 'logo.png', alt: '', class: 'h-9 w-9 shrink-0 rounded-full' %>
        <span class="sidebar-label truncate text-lg font-bold tracking-wide">Dink Pony Club</span>
      <% end %>
    </div>

    <ul class="mt-2 flex flex-col gap-1">
      <% sidebar_items.each do |item| %>
        <li>
          <% if item[:path] %>
            <%= link_to item[:path], class: 'nav-link gap-3 px-4', title: item[:label], data: { action: 'click->sidebar#linkClicked' } do %>
              <%= render 'shared/icon', name: item[:icon], class: 'h-6 w-6 shrink-0' %>
              <span class="sidebar-label"><%= item[:label] %></span>
            <% end %>
          <% else %>
            <span class="nav-link gap-3 px-4 text-gray-400 cursor-not-allowed select-none" aria-disabled="true" title="<%= item[:label] %>">
              <%= render 'shared/icon', name: item[:icon], class: 'h-6 w-6 shrink-0' %>
              <span class="sidebar-label"><%= item[:label] %></span>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>

    <div class="mt-auto flex flex-col gap-1">
      <% if app_version %>
        <p class="px-4 text-[10px] leading-none text-white/40" title="<%= app_version_title %>">v<%= app_version %></p>
      <% end %>
      <div class="flex flex-col gap-1 border-t border-white/10 pt-2">
        <%= render 'layouts/sidebar_install' %>
        <%= render 'layouts/sidebar_account' %>
      </div>
    </div>
  </aside>

  <%= render 'layouts/sidebar_install_dialog' %>
</div>
