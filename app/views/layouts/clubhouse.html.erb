<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Dink Pony Club · League</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link rel="stylesheet" href="/clubhouse-assets/clubhouse.css">
</head>
<body>
  <nav aria-label="Site navigation" style="padding: 12px 6%; display:flex; gap:24px">
    <%= link_to 'Club home', root_path, data: { turbo: false } %>
    <%= link_to 'My Google account', profile_path, data: { turbo: false } %>
    <% if admin? %><%= link_to 'Import seasons', clubhouse_setup_path %><% end %>
  </nav>
  <% if alert %><p role="alert"><%= alert %></p><% end %>
  <%= yield %>
</body>
</html>
