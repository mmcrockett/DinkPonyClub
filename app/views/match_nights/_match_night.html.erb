<% canceled = match_night.canceled? %>
<div id="<%= dom_id(match_night) %>" class="rounded-md bg-white shadow-sm">
  <div class="flex flex-wrap items-center justify-between gap-3 p-4 <%= 'border-b border-gray-100' unless canceled %>">
    <div class="flex items-center gap-4">
      <div class="flex flex-col items-center rounded-md border border-gray-200 px-3 py-1 text-center">
        <span class="text-xs font-bold uppercase text-gray-500"><%= match_night.played_on.strftime('%b') %></span>
        <span class="text-lg font-extrabold text-dpc-navy"><%= match_night.played_on.strftime('%d') %></span>
      </div>

      <div>
        <div class="flex items-center gap-2">
          <span class="font-bold text-dpc-navy"><%= match_night.label %></span>
          <% if match_night == @next_match_night %>
            <span class="rounded-full bg-dpc-green px-2 py-0.5 text-xs font-bold uppercase text-white">
              <%= t('match_nights.schedule.up_next') %>
            </span>
          <% end %>
        </div>
        <% unless canceled %>
          <p class="text-sm text-gray-500">
            <% if match_night.match_slots.any? %>
              <%= match_night.match_slots.first.label %> &middot;
            <% end %>
            <%= match_night.venue %>
          </p>
          <% if match_night.notes.present? %>
            <p class="text-sm text-gray-500"><%= match_night.notes %></p>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <span class="rounded-full px-3 py-1 text-xs font-bold uppercase <%= match_night_status_classes(match_night) %>">
        <%= match_night_status_label(match_night) %>
      </span>
      <% if admin? %>
        <%= link_to edit_admin_match_night_path(match_night), class: 'text-gray-400 hover:text-dpc-navy',
                    title: t('match_nights.schedule.edit_night'), aria: { label: t('match_nights.schedule.edit_night') } do %>
          <%= render 'shared/icon', name: 'pencil-square', class: 'h-5 w-5' %>
        <% end %>
      <% end %>
    </div>
  </div>

  <% unless canceled %>
    <div class="flex flex-col divide-y divide-gray-100 px-4">
      <% match_night.matches.each do |match| %>
        <% lineup_teams = lineup_teams_for(match, match_night) %>
        <% home_icon = lineup_icon_link(match, match.home_team, lineup_teams) %>
        <% away_icon = lineup_icon_link(match, match.away_team, lineup_teams) %>
        <% path, label = scorecard_target(match) %>
        <% matchup = capture do %>
          <span class="flex-1 text-right font-semibold"><%= path ? match.home_team.name : team_link(match.home_team, match.season_id) %></span>
          <span class="w-20 text-center font-bold text-dpc-navy"><%= match_score_label(match) %></span>
          <span class="flex-1 font-semibold"><%= path ? match.away_team.name : team_link(match.away_team, match.season_id) %></span>
        <% end %>
        <div class="flex items-center gap-2 py-2">
          <span class="w-8 shrink-0"><%= home_icon %></span>
          <% if path %>
            <%= link_to matchup, path, title: label,
                        class: 'flex flex-1 items-center gap-3 rounded-md py-1 hover:bg-gray-50' %>
          <% else %>
            <div class="flex flex-1 items-center gap-3 py-1"><%= matchup %></div>
          <% end %>
          <span class="w-8 shrink-0"><%= away_icon %></span>
        </div>
      <% end %>
    </div>

    <% if @team_view %>
      <%= render 'match_nights/team_availability', match_night: match_night unless match_night.past? %>
    <% else %>
      <%= render 'match_nights/availability_control', match_night: match_night %>
    <% end %>
  <% end %>
</div>
