<% content_for :title, @match_night.label %>

<div class="flex flex-col gap-4">
  <%= link_to "&larr; #{t('match_nights.schedule.back_to_schedule')}".html_safe, season_match_nights_path(@season),
              class: 'text-dpc-navy font-semibold' %>

  <%= render 'match_night', match_night: @match_night %>
  <% bracket = PlayoffBracket.new(@match_night) %>
  <% if bracket.any? %>
    <%= render 'bracket', bracket: bracket %>
  <% end %>
  <% if @court_schedule&.any? && !@match_night.canceled? %>
    <%= render 'court_schedule', schedule: @court_schedule %>
  <% end %>

  <section class="flex flex-col gap-4" aria-labelledby="match-night-photos">
    <h2 id="match-night-photos" class="text-xl font-bold text-dpc-navy"><%= t('photos.title') %></h2>

    <% if @photos.any? %>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
        <% @photos.each do |photo| %>
          <figure class="overflow-hidden rounded-lg bg-white shadow-sm">
            <%= link_to match_night_photo_path(@match_night, photo) do %>
              <%= image_tag thumbnail_match_night_photo_path(@match_night, photo), alt: photo.filename.to_s,
                            loading: 'lazy', class: 'aspect-square w-full object-cover' %>
            <% end %>
            <% if can_remove_photo?(photo) %>
              <figcaption class="p-2">
                <%= button_to t('photos.remove'), match_night_photo_path(@match_night, photo), method: :delete,
                              class: 'btn btn-secondary', form: { data: { turbo_confirm: t('photos.confirm_remove') } } %>
              </figcaption>
            <% end %>
          </figure>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-gray-500"><%= t('photos.empty') %></p>
    <% end %>

    <%= form_with url: match_night_photos_path(@match_night), class: 'flex flex-col gap-3 rounded-lg bg-white p-4 shadow-sm',
                  data: { controller: 'photo-upload' } do |form| %>
      <div class="flex flex-col gap-1">
        <%= form.label :photos, t('photos.choose'), class: 'text-sm font-semibold text-dpc-navy' %>
        <%= form.file_field :photos, multiple: true, accept: MatchNight::PHOTO_TYPES.join(','),
                            required: true, data: { photo_upload_target: 'file', action: 'change->photo-upload#upload' },
                            class: 'block w-full text-sm text-gray-600 file:mr-3 file:cursor-pointer file:rounded-md file:border-0 file:bg-dpc-navy file:px-4 file:py-2 file:font-semibold file:text-white' %>
      </div>
      <div data-photo-upload-target="submit">
        <%= form.submit t('photos.upload'), class: 'btn btn-primary' %>
      </div>
    <% end %>
  </section>
</div>
