<% content_for :title, @match_night.label %>

<div class="flex flex-col gap-4">
  <%= link_to "&larr; #{t('match_nights.schedule.back_to_schedule')}".html_safe, season_match_nights_path(@season),
              class: 'text-dpc-navy font-semibold' %>

  <%= render 'match_night', match_night: @match_night %>
  <% if @court_schedule&.any? && !@match_night.canceled? %>
    <%= render 'court_schedule', schedule: @court_schedule %>
  <% end %>
</div>
