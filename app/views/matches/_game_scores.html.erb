<section class="rounded-md bg-white px-4 py-3 shadow-sm">
  <h2 class="text-sm font-bold uppercase text-dpc-navy">Game <%= number %></h2>
  <div class="mt-1 grid grid-cols-[3rem_1fr_auto_1fr] items-center gap-x-2 text-xs font-semibold uppercase text-gray-500">
    <span></span>
    <span class="text-right"><%= @match.home_team.name %></span>
    <span></span>
    <span><%= @match.away_team.name %></span>
  </div>

  <% @form.lines.each do |line| %>
    <div class="mt-2 grid grid-cols-[3rem_1fr_auto_1fr] items-center gap-x-2" data-scorecard-target="row" data-line="<%= line.position %>" data-game="<%= number %>">
      <span class="text-xs font-semibold text-gray-500">Line <%= line.position %></span>
      <span class="text-right text-xs text-gray-600" data-pair="home"><%= pair_names(line, :home, number - 1, @players_by_id) %></span>
      <div class="flex items-center gap-1">
        <% %i[home away].each_with_index do |side, index| %>
          <%= text_field_tag "scorecard[lines][#{line.position}][#{side}_score#{number}]", line.scores[number - 1][index],
                class: 'form-input !h-12 !w-16 text-center text-xl', inputmode: 'numeric', pattern: '[0-9]*',
                maxlength: 2, autocomplete: 'off', enterkeyhint: 'next',
                'aria-label': "Line #{line.position} game #{number} #{side} score",
                data: { scorecard_target: 'score', side: side,
                        action: 'input->scorecard#scoreChanged keydown->scorecard#scoreKeydown' } %>
          <%= tag.span('-', class: 'text-gray-400') if index.zero? %>
        <% end %>
      </div>
      <span class="text-xs text-gray-600" data-pair="away"><%= pair_names(line, :away, number - 1, @players_by_id) %></span>
    </div>
  <% end %>
</section>
