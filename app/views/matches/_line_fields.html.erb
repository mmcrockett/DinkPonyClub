<div class="rounded-md bg-white px-4 py-3 shadow-sm">
  <p class="text-sm font-semibold text-dpc-navy mb-2">Line <%= line.position %></p>

  <div class="grid grid-cols-2 gap-4">
    <div class="flex flex-col gap-2">
      <p class="text-xs font-semibold uppercase text-gray-500"><%= @match.home_team.name %></p>
      <% (0..2).each do |slot| %>
        <%= select_tag "scorecard[lines][#{line.position}][home_player_ids][]",
              options_for_select(@home_roster.map { |player| [player.full_name, player.id] }, line.home_player_ids[slot]),
              include_blank: true, class: 'rounded-md border-gray-300 shadow-sm' %>
      <% end %>
    </div>
    <div class="flex flex-col gap-2">
      <p class="text-xs font-semibold uppercase text-gray-500"><%= @match.away_team.name %></p>
      <% (0..2).each do |slot| %>
        <%= select_tag "scorecard[lines][#{line.position}][away_player_ids][]",
              options_for_select(@away_roster.map { |player| [player.full_name, player.id] }, line.away_player_ids[slot]),
              include_blank: true, class: 'rounded-md border-gray-300 shadow-sm' %>
      <% end %>
    </div>
  </div>

  <div class="mt-3 grid grid-cols-3 gap-3">
    <% (1..Lineup::GAMES_PER_LINEUP).each do |number| %>
      <div class="flex flex-col gap-1">
        <span class="text-xs font-semibold text-gray-500">Game <%= number %></span>
        <div class="flex items-center gap-1">
          <%= number_field_tag "scorecard[lines][#{line.position}][home_score#{number}]", line.scores[number - 1][0],
                class: 'w-16 rounded-md border-gray-300 shadow-sm', min: 0, max: 99 %>
          <span>-</span>
          <%= number_field_tag "scorecard[lines][#{line.position}][away_score#{number}]", line.scores[number - 1][1],
                class: 'w-16 rounded-md border-gray-300 shadow-sm', min: 0, max: 99 %>
        </div>
      </div>
    <% end %>
  </div>
</div>
