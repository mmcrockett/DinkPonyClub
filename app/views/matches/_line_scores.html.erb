<section class="rounded-md bg-white px-4 py-3 shadow-sm">
  <h2 class="text-sm font-bold uppercase text-dpc-navy">Line <%= line.position %></h2>

  <% (1..Lineup::GAMES_PER_LINEUP).each do |number| %>
    <div class="mt-3 border-t border-gray-100 pt-3" data-scorecard-target="row" data-line="<%= line.position %>" data-game="<%= number %>">
      <p class="mb-1 text-xs font-bold uppercase text-gray-500">Game <%= number %></p>
      <% [[:home, @match.home_team], [:away, @match.away_team]].each_with_index do |(side, team), index| %>
        <div class="flex items-center justify-between gap-3 <%= 'mt-2' if index == 1 %>">
          <div class="min-w-0">
            <p class="text-[0.65rem] font-semibold uppercase text-gray-500"><%= team.name %></p>
            <p class="text-sm font-medium text-gray-900" data-pair="<%= side %>"><%= pair_names(line, side, number - 1, @players_by_id) %></p>
          </div>
          <%= text_field_tag "scorecard[lines][#{line.position}][#{side}_score#{number}]", line.scores[number - 1][index],
                class: 'form-input !h-12 !w-20 shrink-0 text-center text-2xl', inputmode: 'numeric', pattern: '[0-9]*',
                maxlength: 2, autocomplete: 'off', enterkeyhint: 'next',
                'aria-label': "Line #{line.position} game #{number} #{side} score",
                data: { scorecard_target: 'score', side: side,
                        action: 'input->scorecard#scoreChanged keydown->scorecard#scoreKeydown' } %>
        </div>
      <% end %>
    </div>
  <% end %>
</section>
