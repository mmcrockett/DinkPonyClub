<%# locals: (line:, ready: true) %>
<section class="rounded-md bg-white px-3 py-2 shadow-sm">
  <% if line.position == @match.line_positions.first %>
    <div class="grid grid-cols-[3rem_1fr_1.25rem_1fr] items-end gap-x-2 text-xs font-semibold uppercase text-gray-400">
      <span></span>
      <span class="truncate"><%= @match.home_team.name %></span>
      <span></span>
      <span class="truncate"><%= @match.away_team.name %></span>
    </div>
  <% end %>

  <div class="grid grid-cols-[3rem_1fr_1.25rem_1fr] items-baseline gap-x-2">
    <h2 class="text-xs font-bold uppercase text-dpc-navy">Line <%= line.position %></h2>
    <span class="text-xs font-semibold leading-tight text-gray-700"><%= side_names(line.home_player_ids, @players_by_id) %></span>
    <span></span>
    <span class="text-xs font-semibold leading-tight text-gray-700"><%= side_names(line.away_player_ids, @players_by_id) %></span>
  </div>

  <% (1..Lineup::GAMES_PER_LINEUP).each do |number| %>
    <div class="mt-1 grid grid-cols-[3rem_1fr_1.25rem_1fr] items-end gap-x-2"
         data-scorecard-target="row" data-line="<%= line.position %>" data-game="<%= number %>"
         data-url="<%= match_lineup_game_path(@match, line.position, number, format: :json) %>">
      <span class="pb-2 text-xs font-bold uppercase text-gray-500">G<%= number %></span>
      <% %i[home away].each_with_index do |side, index| %>
        <div class="flex min-w-0 flex-col">
          <% if line.public_send(:"#{side}_player_ids").size > 2 %>
            <span class="text-[11px] leading-tight text-gray-500"><%= pair_names(line, side, number - 1, @players_by_id) %></span>
          <% end %>
          <%= text_field_tag "scorecard[lines][#{line.position}][#{side}_score#{number}]", line.scores[number - 1][index],
                class: 'form-input !h-10 !w-full text-center text-xl disabled:!bg-gray-200 disabled:cursor-not-allowed', inputmode: 'numeric', pattern: '[0-9]*',
                maxlength: 2, autocomplete: 'off', enterkeyhint: 'next', disabled: !ready,
                'aria-label': "Line #{line.position} game #{number} #{side} score",
                data: { scorecard_target: 'score', side: side,
                        action: 'input->scorecard#scoreChanged keydown->scorecard#scoreKeydown' } %>
        </div>
        <%= tag.span('vs', class: 'pb-2 text-center text-xs text-gray-400') if index.zero? %>
      <% end %>
    </div>
  <% end %>
</section>
