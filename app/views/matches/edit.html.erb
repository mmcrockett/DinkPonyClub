<div class="mx-auto flex max-w-2xl flex-col gap-3 pb-16">
  <div>
    <p class="text-sm font-medium text-gray-500"><%= @match.match_night.label %> &middot; <%= @match.played_on.strftime('%A, %B %-d') %></p>
    <h1 class="text-2xl font-extrabold text-dpc-navy">
      <%= @match.home_team.name %> <span class="text-gray-400">vs</span> <%= @match.away_team.name %>
    </h1>
  </div>

  <%= form_with url: match_path(@match), method: :patch, class: 'flex flex-col gap-3',
        data: { controller: 'scorecard', action: 'submit->scorecard#finish',
                scorecard_url_value: match_path(@match, format: :json),
                scorecard_done_url_value: match_path(@match),
                scorecard_persisted_value: @match.lineups.any? && @form.errors.none? } do |form| %>
    <%= hidden_field_tag :fingerprint, @form.fingerprint, data: { scorecard_target: 'fingerprint' } %>

    <% if @form.errors.any? %>
      <div class="rounded-md bg-red-50 px-4 py-3 text-sm text-red-700">
        <ul class="list-disc pl-4">
          <% @form.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% editable_teams = [@match.home_team, @match.away_team].select { |team| admin? || captain_team_ids_in(@match.season_id).include?(team.id) } %>

    <% ready = @form.lineup_ready? %>
    <% unless ready %>
      <p class="rounded-md bg-amber-50 px-4 py-3 text-sm text-amber-900">
        <%= t('.incomplete') %>
        <% editable_teams.each do |team| %>
          <%= link_to (editable_teams.one? ? t('.enter_lineup') : t('.enter_team_lineup', team: team.name)),
                      season_matchup_path(@match.season_id, team_id: team.id, match_id: @match.id), class: 'font-semibold underline' %>
        <% end %>
      </p>
    <% end %>

    <% @form.lines.each do |line| %>
      <%= render 'line_players_fields', line: line %>
    <% end %>

    <div class="flex flex-col gap-3 <%= 'opacity-40 grayscale select-none' unless ready %>">
      <% @form.lines.each do |line| %>
        <%= render 'line_scores', line: line, ready: ready %>
      <% end %>

      <%= form.submit 'Done', disabled: !ready, class: 'btn btn-primary w-full sm:w-auto sm:self-start disabled:cursor-not-allowed' %>
    </div>

    <div class="fixed inset-x-0 bottom-0 bg-white px-4 py-2 text-center text-sm text-gray-600 shadow-[0_-1px_3px_rgba(0,0,0,0.1)] empty:hidden"
         data-scorecard-target="status" role="status" aria-live="polite"></div>
  <% end %>
</div>
