<%# locals: (cards:, season:, selected_match:) %>
<section aria-label="<%= t('matchups.show.cards.title') %>">
  <div class="flex snap-x gap-3 overflow-x-auto pb-1">
    <% cards.each do |card| %>
      <% current = card.match.id == selected_match.id %>
      <%= link_to season_matchup_path(season, match_id: card.match.id),
                  class: "block w-56 shrink-0 snap-start rounded-lg border bg-white shadow-sm hover:bg-gray-50 #{current ? 'border-dpc-navy ring-2 ring-dpc-navy' : 'border-gray-200'}",
                  aria: { current: (true if current) } do %>
        <% [card.home, card.away].each_with_index do |side, index| %>
          <div class="flex items-center gap-2 px-3 py-2 <%= 'border-t border-gray-100' if index.positive? %>">
            <%= team_logo(side.team, class: 'h-7 w-7 shrink-0 rounded-full object-cover') %>
            <span class="min-w-0 flex-1">
              <span class="block truncate text-sm font-bold text-dpc-navy"><%= side.team.name %></span>
              <span class="block text-xs text-gray-500"><%= side.record %></span>
            </span>
            <span class="text-right">
              <span class="block text-sm font-extrabold text-dpc-navy"><%= side.pupr ? number_with_precision(side.pupr, precision: 2) : '-' %></span>
              <span class="block text-[10px] uppercase text-gray-400"><%= t('matchups.show.cards.pupr') %></span>
            </span>
            <span class="w-12 shrink-0 rounded-full border border-gray-400 px-1 py-0.5 text-center text-xs font-bold text-dpc-navy"
                  title="<%= t('matchups.show.scoreboard.odds') %>"><%= side.odds || '-' %></span>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
</section>
