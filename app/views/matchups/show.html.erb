<% content_for :title, t('.title') %>

<div class="mx-auto flex max-w-3xl flex-col gap-6">
  <%= render 'shared/season_breadcrumb', season: @season, all_time: false %>

  <div class="flex flex-wrap items-start justify-between gap-4">
    <h1 class="text-2xl font-extrabold text-dpc-navy"><%= t('.title') %></h1>

    <% if @teams.size > 1 %>
      <%= form_with url: season_matchup_path(@season), method: :get, class: 'flex items-center gap-2' do |form| %>
        <%= form.label :team_id, t('.team'), class: 'sr-only' %>
        <%= form.select :team_id, options_from_collection_for_select(@teams, :id, :name, @team&.id),
                        {}, class: 'rounded-md border border-gray-300 px-2 py-1 text-sm' %>
        <%= form.submit t('.view'), class: 'rounded-md bg-dpc-navy px-3 py-1 text-sm font-bold text-white' %>
      <% end %>
    <% end %>
  </div>

  <% if @board %>
    <div class="flex flex-wrap items-center justify-between gap-2">
      <p class="font-bold text-dpc-navy">
        <%= t('.versus', team: @team.name, opponent: @board.opponent.name) %>
        <span class="font-normal text-gray-500"><%= l(@match.played_on, format: :long) %></span>
      </p>
      <% if @editable %>
        <%= link_to t('.edit_lineup'), edit_match_team_lineup_path(@match, @team), class: 'text-sm font-bold text-dpc-navy hover:underline' %>
      <% end %>
    </div>

    <%= form_with url: match_team_lineup_path(@match, @team), method: :patch, id: 'matchup-lineup',
                  data: { controller: 'lineup-move', lineup_move_empty_value: tag.span(t('.empty'), class: 'text-gray-400'),
                          lineup_move_move_value: t('.move'), lineup_move_cancel_value: t('.cancel'),
                          lineup_move_subs_url_value: match_team_subs_path(@match, @team), lineup_move_here_value: t('.here'), lineup_move_extra_here_value: t('.extra_here'),
                          lineup_move_loading_value: t('.loading_subs'),
                          lineup_move_no_subs_value: t('.no_subs'), lineup_move_failed_value: t('.subs_failed') } do %>
      <%= hidden_field_tag :return_to, season_matchup_path(@season, team_id: @team.id) %>

      <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white shadow-sm">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-gray-200 text-xs font-bold uppercase text-gray-500">
            <tr>
              <th class="px-4 py-2"><%= t('.slot') %></th>
              <th class="px-4 py-2"><%= t('.player') %></th>
              <th class="px-4 py-2 text-right"><%= t('.pupr') %></th>
              <th class="px-4 py-2 text-right"><%= t('.elo') %></th>
              <% if @editable %>
                <th class="px-4 py-2 text-right">
                  <button type="button" class="rounded-full border border-dpc-navy px-3 py-1 text-xs font-bold uppercase text-dpc-navy"
                          data-action="lineup-move#openSubs"><%= t('.add_sub') %></button>
                </th>
              <% end %>
            </tr>
          </thead>
          <% @board.lines.each do |position, rows| %>
            <% state = rows.count(&:player) >= 2 ? 'complete' : 'incomplete' %>
            <tbody class="border-b border-gray-200">
              <% rows.each_with_index do |row, index| %>
                <% extra = index >= MatchupBoard::MIN_SEATS %>
                <%= render 'row', row: row, label: extra ? t('.extra') : t('.line', number: position), state: state, position: position,
                                  editable: @editable, extra: extra %>
              <% end %>
            </tbody>
          <% end %>
          <tbody data-lineup-move-target="subSources">
            <% if @editable %>
              <%= render 'row', row: MatchupBoard::EMPTY_ROW, label: t('.bench'), state: 'bench', editable: true, bench_new: true %>
            <% end %>
            <% @board.bench.each do |row| %>
              <%= render 'row', row: row, label: t('.bench'), state: 'bench', editable: @editable %>
            <% end %>
            <% if @editable %>
              <% @board.picked_subs.each do |row| %>
                <%= render 'row', row: row, label: t('.bench'), state: 'bench', editable: true, sub_source: true %>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @editable %>
        <dialog class="fixed inset-x-0 bottom-0 top-auto m-0 w-full max-w-none rounded-t-xl bg-white p-4 shadow-xl backdrop:bg-black/40 sm:inset-0 sm:m-auto sm:max-w-md sm:rounded-xl"
                data-lineup-move-target="subPanel" data-action="click->lineup-move#closeSubs">
          <div class="mb-3 flex items-center justify-between">
            <p class="text-sm font-bold uppercase text-gray-500"><%= t('.choose_sub') %></p>
            <button type="button" data-close class="rounded-md border border-gray-400 px-3 py-1 text-sm font-bold text-gray-600"><%= t('.close') %></button>
          </div>
          <div class="grid grid-cols-[1fr_4rem_4rem] px-3 pb-1 text-xs font-bold uppercase text-gray-500">
            <span><%= t('.player') %></span>
            <span class="text-right"><%= t('.pupr') %></span>
            <span class="text-right"><%= t('.elo') %></span>
          </div>
          <ul class="flex max-h-[60vh] flex-col overflow-y-auto" data-lineup-move-target="subList"></ul>
        </dialog>

        <div class="mt-4 flex items-center gap-3">
          <%= submit_tag t('.save'), disabled: true, data: { lineup_move_target: 'save' },
                         class: 'rounded-md bg-dpc-navy px-4 py-2 text-sm font-bold text-white disabled:cursor-not-allowed disabled:bg-gray-300 disabled:text-gray-500' %>
          <%= link_to t('.cancel'), season_matchup_path(@season, team_id: @team.id), class: 'text-sm font-bold text-gray-600 hover:underline' %>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <p class="text-gray-500"><%= t('.no_match') %></p>
  <% end %>
</div>
