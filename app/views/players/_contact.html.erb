<div class="text-sm">
  <% if !show_contacts %>
    <p class="text-gray-500"><%= t('players.contact_hidden') %></p>
  <% elsif player.email.blank? && player.phone.blank? %>
    <p class="text-gray-500"><%= t('players.no_contact') %></p>
  <% else %>
    <% if player.email.present? %>
      <p><%= mail_to player.email, class: 'text-dpc-navy underline' %></p>
    <% end %>
    <% if player.phone.present? %>
      <p><%= link_to player.phone, "tel:#{player.phone}", class: 'text-dpc-navy underline' %></p>
    <% end %>
  <% end %>
</div>
