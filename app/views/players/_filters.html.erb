<%= form_with url: players_path, method: :get, class: 'flex flex-wrap items-center gap-3', data: { controller: 'auto-submit' } do |form| %>
  <% if Season.count > 1 %>
    <%= form.select :season, Season.chronological.map { |s| [s.name, s.id] }, { selected: season&.id },
                     class: 'rounded-md border border-gray-300 px-3 py-2', aria: { label: t('players.filters.season') },
                     data: { action: 'change->auto-submit#submit' } %>
  <% elsif season %>
    <%= form.hidden_field :season, value: season.id %>
  <% end %>

  <%= form.search_field :q, value: filter.query, placeholder: t('players.filters.search'), autocomplete: 'off',
                              class: 'rounded-md border border-gray-300 px-3 py-2', aria: { label: t('players.filters.search') },
                              data: { action: 'input->auto-submit#debouncedSubmit' } %>

  <%= form.select :team,
                  options_for_select([[t('players.filters.all_teams'), '']] + teams.map { |team| [team.name, team.id] } +
                                     [[t('players.filters.substitutes'), StatsFilter::SUBSTITUTES]], filter.team),
                  {}, class: 'rounded-md border border-gray-300 px-3 py-2', aria: { label: t('players.filters.team') },
                      data: { action: 'change->auto-submit#submit' } %>

  <label class="flex items-center gap-2 text-sm text-gray-600">
    <%= form.check_box :hide_substitutes, { checked: filter.hide_substitutes?, data: { action: 'change->auto-submit#submit' } },
                       '1', nil %>
    <%= t('players.filters.hide_substitutes') %>
  </label>

  <%= form.hidden_field :sort, value: filter.sort %>
  <%= form.hidden_field :dir, value: filter.direction %>
<% end %>
