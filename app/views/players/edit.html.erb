<% content_for :title, t('players.edit.title') %>

<div class="mx-auto flex max-w-xl flex-col gap-6">
  <div>
    <h1 class="text-2xl font-extrabold text-dpc-navy"><%= t('players.edit.title') %></h1>
    <p class="text-gray-500"><%= @player.full_name %></p>
  </div>

  <%= form_with model: @player, class: 'flex flex-col gap-4' do |form| %>
    <% if @player.errors.any? %>
      <div class="rounded-md bg-red-50 px-4 py-3 text-sm text-red-700">
        <ul class="list-disc pl-4">
          <% @player.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="flex flex-col gap-4 rounded-md bg-white p-5 shadow-sm">
      <div class="flex flex-col gap-1">
        <%= form.label :contact_email, t('players.edit.contact_email'), class: 'text-sm font-semibold text-dpc-navy' %>
        <%= form.email_field :contact_email, class: 'form-input', aria: { invalid: @player.errors[:contact_email].any? } %>
      </div>

      <div class="flex flex-col gap-1">
        <%= form.label :phone, t('players.edit.phone'), class: 'text-sm font-semibold text-dpc-navy' %>
        <%= form.telephone_field :phone, class: 'form-input', aria: { invalid: @player.errors[:phone].any? } %>
      </div>

      <p class="text-sm text-dpc-navy/70"><%= t('players.edit.visibility_note') %></p>
      <p class="text-sm text-dpc-navy/70"><%= t('players.edit.sign_in_email_note') %></p>
    </div>

    <div class="flex items-center justify-end gap-3">
      <%= link_to t('players.edit.cancel'), player_path(@player), class: 'btn btn-secondary' %>
      <%= form.submit t('players.edit.save'), class: 'btn btn-primary' %>
    </div>
  <% end %>
</div>
