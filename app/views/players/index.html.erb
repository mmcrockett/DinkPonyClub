<% content_for :title, t('players.index.title') %>

<div class="flex flex-col gap-6">
  <%= render 'shared/season_breadcrumb', season: @season %>

  <h1 class="text-2xl font-extrabold text-dpc-navy"><%= t('players.index.title') %></h1>

  <%= turbo_frame_tag 'players', class: 'flex flex-col gap-6', data: { turbo_action: 'advance' } do %>
    <%= render 'filters', season: @season, teams: @teams, filter: @filter, lifetime: @lifetime %>

    <% if @lifetime && @season %>
      <p class="text-sm text-gray-500"><%= t('players.filters.lifetime_note', season: @season.name) %></p>
    <% end %>

    <% if @rows.any? %>
      <div class="overflow-x-auto rounded-md bg-white shadow-sm">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-100 text-xs font-bold uppercase text-gray-500">
              <% @filter.sorts.each do |column| %>
                <th class="px-4 py-3 <%= %w[name team].include?(column) ? 'text-left' : 'text-right' %>"
                    aria-sort="<%= players_aria_sort(@filter, column) %>">
                  <%= players_sort_link(@filter, column, season: @season, lifetime: @lifetime) %>
                </th>
              <% end %>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @rows.each do |row| %>
              <tr id="<%= dom_id(row.player, :stats) %>">
                <td class="px-4 py-3 font-bold text-dpc-navy">
                  <%= link_to row.player.full_name, season_player_path(@season, row.player),
                              class: 'hover:underline', data: { turbo_frame: '_top' } %>
                  <% if @owing_ids.include?(row.player.id) %>
                    <span class="owes-chip ml-1 inline-block align-middle text-amber-600"
                          title="<%= t('players.owes') %>" aria-label="<%= t('players.owes') %>">
                      <%= render 'shared/icon', name: 'currency-dollar', class: 'h-4 w-4' %>
                    </span>
                  <% end %>
                  <% if row.captain %>
                    <span class="captain-chip ml-1 rounded-full bg-dpc-green px-1.5 py-0.5 text-xs font-bold text-white"
                          title="<%= t('players.captain') %>" aria-label="<%= t('players.captain') %>">C</span>
                  <% end %>
                </td>
                <td class="px-4 py-3 <%= row.substitute? ? 'text-gray-400' : 'text-gray-600' %>"><%= player_team_label(row) %></td>
                <td class="px-4 py-3 text-right"><%= row.games %></td>
                <td class="px-4 py-3 text-right"><%= row.wins %></td>
                <td class="px-4 py-3 text-right"><%= row.losses %></td>
                <td class="px-4 py-3 text-right"><%= win_rate_label(row) %></td>
                <% if @filter.ratings? %>
                  <td class="pupr-cell px-4 py-3 text-right <%= 'text-gray-400' if row.rated_games.to_i.zero? %>"
                      title="<%= t('players.rated_games', count: row.rated_games.to_i) %>"><%= pupr_label(row) %></td>
                  <td class="elo-cell px-4 py-3 text-right <%= 'text-gray-400' if row.rated_games.to_i.zero? %>"><%= rating_label(row) %></td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% elsif @season&.roster_spots&.exists? %>
      <p class="text-gray-500"><%= t('players.index.no_matches') %></p>
    <% else %>
      <p class="text-gray-500"><%= t('players.index.empty') %></p>
    <% end %>
  <% end %>
</div>
