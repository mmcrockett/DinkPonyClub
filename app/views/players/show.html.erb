<% content_for :title, @player.full_name %>

<div class="mx-auto flex max-w-3xl flex-col gap-6">
  <%= render 'shared/season_breadcrumb', season: @season %>

  <%= link_to t('players.show.back'), @season ? season_players_path(@season) : players_path, class: 'text-sm font-semibold text-dpc-navy underline' %>

  <div class="flex flex-col gap-4 rounded-md bg-white p-5 shadow-sm">
    <div class="flex items-center gap-4">
      <span class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-dpc-navy text-xl font-bold text-white">
        <%= @player.initials %>
      </span>
      <div class="min-w-0 flex-1">
        <h1 class="text-2xl font-extrabold text-dpc-navy"><%= @player.full_name %></h1>
        <p class="text-gray-500">
          <%= @row ? player_team_label(@row) : t('players.show.not_playing') %>
          <% if @season %> - <%= @season.name %><% end %>
        </p>
      </div>
      <% if @rating %>
        <div class="text-right">
          <p class="flex items-center justify-end gap-1 text-xs font-semibold uppercase text-gray-500">
            <span class="cursor-help" title="<%= t('players.pupr.meaning') %>" aria-label="<%= t('players.pupr.meaning') %>"><%= t('players.pupr.short') %></span>
            <button type="button" popovertarget="pupr-info" class="text-gray-400 hover:text-dpc-navy" aria-label="<%= t('players.pupr.help') %>">
              <%= render 'shared/icon', name: 'question-mark-circle', class: 'h-4 w-4' %>
            </button>
            <span id="pupr-info" popover class="m-0 w-64 rounded-md bg-white p-3 text-left text-sm font-normal normal-case text-gray-700 shadow-lg">
              <%= t('players.pupr.blurb_html') %>
            </span>
          </p>
          <p class="text-2xl font-extrabold text-dpc-navy"><%= number_with_precision(@rating.pupr, precision: 2) %></p>
          <p class="text-xs text-gray-500">
            <span class="cursor-help" title="<%= t('players.elo.meaning') %>" aria-label="<%= t('players.elo.meaning') %>"><%= t('players.elo.short') %></span>
            <span id="<%= dom_id(@player, :elo) %>"><%= @rating.elo.round %></span>
            - <%= t('players.rated_games', count: @rating.games) %>
          </p>
        </div>
      <% end %>
      <% if @row&.captain %>
        <span class="rounded-full bg-dpc-green px-2 py-0.5 text-xs font-bold uppercase text-white">
          <%= t('players.captain') %>
        </span>
      <% end %>
    </div>

    <% if @row %>
      <dl class="grid grid-cols-2 gap-2 sm:grid-cols-4">
        <% [[t('players.show.games'), @row.games], [t('players.show.wins'), @row.wins],
            [t('players.show.losses'), @row.losses], [t('players.show.win_rate'), win_rate_label(@row)]].each do |label, value| %>
          <div>
            <dt class="text-xs font-semibold uppercase text-gray-500"><%= label %></dt>
            <dd class="text-lg font-bold text-dpc-navy"><%= value %></dd>
          </div>
        <% end %>
      </dl>
    <% end %>

    <%= render 'contact', player: @player, show_contacts: @show_contacts %>
  </div>

  <% if @career.rows.any? %>
    <%= render 'career', career: @career, season: @season %>
  <% end %>

  <div class="flex flex-col gap-2">
    <h2 class="text-lg font-bold text-dpc-navy"><%= t('players.show.lines') %></h2>
    <% if @line_results.any? %>
      <ul class="flex flex-col gap-2">
        <% @line_results.each do |lineup, games| %>
          <% line = player_line_summary(@player, lineup, games, @ratings) %>
          <li id="<%= dom_id(lineup, :result) %>" class="flex flex-wrap items-center justify-between gap-3 rounded-md bg-white px-4 py-3 shadow-sm">
            <div>
              <p class="font-semibold text-dpc-navy">
                <%= l(line.match.played_on, format: :short) %> - <%= line.match.match_night.label %>
                <span class="text-gray-500">
                  <%= t('players.show.line_vs_html', position: lineup.position, opponent: team_link(line.opponent, @season)) %>
                </span>
                <span class="ml-1 rounded-full px-2 py-0.5 text-xs font-bold uppercase <%= line.wins > line.losses ? 'bg-dpc-green text-white' : 'bg-gray-100 text-gray-600' %>">
                  <%= "#{line.wins}-#{line.losses}" %>
                </span>
              </p>
              <% if line.partners.any? %>
                <p class="text-sm text-gray-500">
                  <%= t('players.show.partners', names: line.partners.map(&:full_name).to_sentence) %>
                </p>
              <% end %>
            </div>
            <div class="flex items-center gap-3 text-sm">
              <table class="game-results tabular-nums">
                <thead class="text-[10px] font-semibold uppercase text-gray-400">
                  <tr>
                    <th class="text-right font-semibold"><%= t('players.show.score') %></th>
                    <% if line.changes.any? %>
                      <th class="pl-3 text-right font-semibold"><%= t('players.pupr.short') %></th>
                      <th class="pl-3 text-right font-semibold"><%= t('players.elo.short') %></th>
                    <% end %>
                  </tr>
                </thead>
                <tbody>
                  <% line.scores.zip(line.changes).each do |(own, other), change| %>
                    <tr class="game-result">
                      <td class="py-0.5 text-right">
                        <span class="<%= 'font-bold' if own > other %>"><%= own %></span>-<span class="<%= 'font-bold' if other > own %>"><%= other %></span>
                      </td>
                      <% if change %>
                        <td class="rating-change py-0.5 pl-3 text-right text-xs font-semibold <%= rating_change_class(change.pupr) %>"><%= pupr_change_label(change) %></td>
                        <td class="elo-change py-0.5 pl-3 text-right text-xs font-semibold <%= rating_change_class(change.elo.round) %>"><%= elo_change_label(change) %></td>
                      <% end %>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-gray-500"><%= t('players.show.no_lines') %></p>
    <% end %>
  </div>
</div>
