<div class="mx-auto flex max-w-xl flex-col gap-6">
  <div class="flex items-center gap-4">
    <% if @player.avatar_url.present? %>
      <%= image_tag @player.avatar_url, alt: @player.full_name, class: "h-16 w-16 rounded-full" %>
    <% else %>
      <div class="flex h-16 w-16 items-center justify-center rounded-full bg-dpc-navy text-xl font-bold text-white">
        <%= @player.first_name.first %>
      </div>
    <% end %>

    <div>
      <h1 class="text-2xl font-extrabold text-dpc-navy"><%= @player.full_name %></h1>
      <p class="text-gray-500"><%= @player.email %></p>
    </div>
  </div>

  <div>
    <h2 class="text-lg font-bold text-dpc-navy mb-2">Rosters</h2>
    <% if @roster_spots.any? %>
      <ul class="flex flex-col gap-2">
        <% @roster_spots.each do |roster_spot| %>
          <li class="rounded-md bg-white px-4 py-3 shadow-sm">
            <span class="font-semibold"><%= roster_spot.team.name %></span>
            <span class="text-gray-500">- <%= roster_spot.season.name %></span>
            <% if roster_spot.captain? %>
              <span class="ml-2 text-xs font-bold uppercase text-dpc-green">Captain</span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-gray-500">No roster spots yet.</p>
    <% end %>
  </div>
</div>
