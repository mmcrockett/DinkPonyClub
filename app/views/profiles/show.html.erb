<div class="mx-auto flex max-w-xl flex-col gap-6">
  <div class="flex items-center gap-4">
    <% if @player.avatar_url.present? %>
      <%= image_tag @player.avatar_url, alt: @player.full_name, class: "h-16 w-16 rounded-full" %>
    <% else %>
      <div class="flex h-16 w-16 items-center justify-center rounded-full bg-dpc-navy text-xl font-bold text-white">
        <%= @player.first_name.first %>
      </div>
    <% end %>

    <div>
      <h1 class="text-2xl font-extrabold text-dpc-navy"><%= @player.full_name %></h1>
      <p class="text-gray-500"><%= @player.email %></p>
      <%= render 'shared/school_badge', school: @player.school %>
    </div>
  </div>

  <div id="school">
    <h2 class="text-lg font-bold text-dpc-navy mb-2"><%= t('.school.title') %></h2>
    <%= form_with model: @player, url: profile_path, method: :patch,
                  class: 'flex items-center gap-2 rounded-md bg-white px-4 py-3 shadow-sm' do |form| %>
      <%= form.collection_select :school_id, School.by_name, :id, :name, { include_blank: t('schools.unknown') },
                                 class: 'form-input flex-1', aria: { label: t('.school.title') } %>
      <%= form.submit t('.school.save'), class: 'btn btn-primary' %>
    <% end %>
  </div>

  <div>
    <h2 class="text-lg font-bold text-dpc-navy mb-2">Rosters</h2>
    <% if @roster_spots.any? %>
      <ul class="flex flex-col gap-2">
        <% @roster_spots.each do |roster_spot| %>
          <li class="rounded-md bg-white px-4 py-3 shadow-sm">
            <span class="font-semibold"><%= roster_spot.team.name %></span>
            <span class="text-gray-500">- <%= roster_spot.season.name %></span>
            <% if roster_spot.captain? %>
              <span class="ml-2 text-xs font-bold uppercase text-dpc-green">Captain</span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-gray-500">No roster spots yet.</p>
    <% end %>
  </div>

  <div id="calendar_feed">
    <h2 class="text-lg font-bold text-dpc-navy mb-2"><%= t('.calendar.title') %></h2>
    <div class="flex flex-col gap-3 rounded-md bg-white px-4 py-3 shadow-sm">
      <p class="text-gray-700"><%= t('.calendar.description') %></p>
      <p class="text-sm font-semibold text-red-700"><%= t('.calendar.warning') %></p>

      <label for="calendar_feed_url" class="text-sm text-gray-500"><%= t('.calendar.url_label') %></label>
      <input id="calendar_feed_url" type="text" readonly value="<%= @calendar_url %>"
             class="form-input font-mono text-sm">

      <div class="flex flex-wrap gap-2">
        <%= link_to t('.calendar.subscribe'), @webcal_url, class: 'btn btn-primary' %>
        <%= button_to t('.calendar.regenerate'), profile_calendar_token_path,
                      class: 'btn btn-secondary',
                      form: { data: { turbo_confirm: t('.calendar.regenerate_confirm') } } %>
      </div>
    </div>
  </div>
</div>
