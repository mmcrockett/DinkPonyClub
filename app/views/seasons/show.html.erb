<% content_for :title, @season.name %>

<div class="flex flex-col gap-6">
  <%= render 'shared/season_breadcrumb', season: @season %>

  <div>
    <h1 class="text-2xl font-extrabold text-dpc-navy"><%= @season.name %></h1>
    <p class="text-gray-500"><%= t('.weeks_played', count: @weeks_completed) %></p>
  </div>

  <% if @next_match_night %>
    <section class="flex flex-col gap-3">
      <div class="flex items-baseline justify-between gap-3">
        <h2 class="text-xl font-extrabold text-dpc-navy"><%= t('.up_next') %></h2>
        <%= link_to t('.full_schedule'), season_match_nights_path(@season), class: 'text-sm font-semibold text-dpc-green hover:underline' %>
      </div>
      <%= render 'match_nights/match_night', match_night: @next_match_night %>
    </section>
  <% end %>

  <section class="flex flex-col gap-3">
    <div class="flex items-baseline justify-between gap-3">
      <h2 class="text-xl font-extrabold text-dpc-navy"><%= t('.standings') %></h2>
      <%= link_to t('.full_standings'), season_standings_path(@season), class: 'text-sm font-semibold text-dpc-green hover:underline' %>
    </div>

    <% if @rows.any? %>
      <%= render 'standings/table', rows: @rows, season: @season %>
    <% else %>
      <p class="text-gray-500"><%= t('standings.show.empty') %></p>
    <% end %>
  </section>

  <% if @recent_night %>
    <section class="recent-results flex flex-col gap-3">
      <h2 class="text-xl font-extrabold text-dpc-navy"><%= t('.recent_results', label: @recent_night.label) %></h2>
      <div class="flex flex-col divide-y divide-gray-100 rounded-md bg-white px-4 shadow-sm">
        <% @recent_night.matches.each do |match| %>
          <div class="flex items-center justify-between gap-3 py-3">
            <span class="flex-1 text-right font-semibold"><%= team_link(match.home_team, @season) %></span>
            <div class="flex w-28 flex-col items-center">
              <span class="font-bold text-dpc-navy"><%= match_score_label(match) %></span>
              <%= link_to t('match_nights.schedule.scorecard'), match_path(match),
                          class: 'text-xs font-semibold text-dpc-green hover:underline' %>
            </div>
            <span class="flex-1 font-semibold"><%= team_link(match.away_team, @season) %></span>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
