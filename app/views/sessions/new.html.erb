<% content_for :title, t('.title') %>

<div class="mx-auto flex max-w-md flex-col gap-6">
  <h1 class="text-2xl font-extrabold text-dpc-navy"><%= t('.title') %></h1>

  <div class="flex flex-col gap-4 rounded-md bg-white p-5 shadow-sm">
    <%= button_to t('.google'), '/auth/google_oauth2', method: :post, class: 'btn btn-primary w-full', form: { data: { turbo: false } } %>
  </div>

  <%= form_with url: magic_link_path, method: :post, class: 'flex flex-col gap-4 rounded-md bg-white p-5 shadow-sm' do |form| %>
    <p class="text-sm text-dpc-navy/70"><%= t('.or') %></p>

    <div class="flex flex-col gap-1">
      <%= form.label :email, t('.email'), class: 'text-sm font-semibold text-dpc-navy' %>
      <%= form.email_field :email, required: true, autocomplete: 'email', class: 'form-input' %>
    </div>

    <%= form.submit t('.send_link'), class: 'btn btn-secondary' %>
  <% end %>
</div>
