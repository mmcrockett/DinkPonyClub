<% seasons = Season.chronological.to_a %>
<% if seasons.size > 1 %>
  <%= form_with url: url, method: :get, class: 'flex items-center gap-2' do |form| %>
    <%= form.select :season, seasons.map { |s| [s.name, s.id] }, { selected: season&.id },
                     class: 'rounded-md border border-gray-300 px-3 py-2' %>
    <%= form.submit 'Go', name: nil, class: 'btn bg-dpc-navy text-white' %>
  <% end %>
<% end %>
