<% if season %>
  <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-gray-500">
    <%= link_to t('shared.season_breadcrumb.league'), root_path, class: 'hover:underline' %>
    <span aria-hidden="true">&rsaquo;</span>
    <% if Season.count > 1 %>
      <details class="relative">
        <summary class="cursor-pointer list-none rounded-md border border-gray-300 bg-white px-3 py-1 font-semibold text-dpc-navy">
          <%= season.name %> <span aria-hidden="true">&#9662;</span>
        </summary>
        <ul class="absolute z-10 mt-1 min-w-40 rounded-md bg-white py-1 shadow-lg ring-1 ring-black/5">
          <% Season.chronological.each do |option| %>
            <li>
              <%= link_to option.name, season_switch_path(option, except: %w[team]),
                          class: "block px-3 py-1.5 hover:bg-gray-100 #{option == season ? 'font-bold text-dpc-navy' : 'text-gray-700'}",
                          aria: { current: (option == season ? 'true' : nil) } %>
            </li>
          <% end %>
        </ul>
      </details>
    <% else %>
      <span class="font-semibold text-dpc-navy"><%= season.name %></span>
    <% end %>
  </nav>
<% end %>
