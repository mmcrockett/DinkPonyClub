<% content_for :title, t('standings.show.title') %>

<div class="flex flex-col gap-6">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-extrabold text-dpc-navy"><%= t('standings.show.title') %></h1>
      <p class="text-gray-500"><%= t('standings.show.subtitle') %></p>
    </div>

    <div class="flex items-center gap-3">
      <span class="rounded-full bg-dpc-navy px-3 py-1 text-xs font-bold uppercase text-white">
        <%= t('standings.show.results_posted', count: @results_posted) %>
      </span>

      <% if Season.count > 1 %>
        <%= form_with url: standings_path, method: :get, class: 'flex items-center gap-2' do |form| %>
          <%= form.select :season, Season.chronological.map { |s| [s.name, s.id] }, { selected: @season&.id },
                           class: 'rounded-md border border-gray-300 px-3 py-2' %>
          <%= form.submit 'Go', class: 'btn bg-dpc-navy text-white' %>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if @rows.any? %>
    <% if @results_posted.positive? %>
      <div class="grid gap-4 md:grid-cols-3">
        <% @rows.first(3).each_with_index do |row, index| %>
          <%= render 'podium_card', row: row, rank: index + 1 %>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-500"><%= t('standings.show.no_results_yet') %></p>
    <% end %>

    <div class="overflow-x-auto rounded-md bg-white shadow-sm">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-gray-100 text-xs font-bold uppercase text-gray-500">
            <th class="px-4 py-3 text-left"><%= t('standings.show.table.rank') %></th>
            <th class="px-4 py-3 text-left"><%= t('standings.show.table.team') %></th>
            <th class="px-4 py-3 text-right"><%= t('standings.show.table.played') %></th>
            <th class="px-4 py-3 text-right"><%= t('standings.show.table.wins') %></th>
            <th class="px-4 py-3 text-right"><%= t('standings.show.table.losses') %></th>
            <th class="px-4 py-3 text-right"><%= t('standings.show.table.ties') %></th>
            <th class="px-4 py-3 text-right"><%= t('standings.show.table.points_for') %></th>
            <th class="px-4 py-3 text-right"><%= t('standings.show.table.points_against') %></th>
            <th class="px-4 py-3 text-right"><%= t('standings.show.table.diff') %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @rows.each_with_index do |row, index| %>
            <tr id="<%= dom_id(row.team, :standings) %>">
              <td class="px-4 py-3 text-gray-500"><%= index + 1 %></td>
              <td class="px-4 py-3 font-bold text-dpc-navy"><%= row.team.name %></td>
              <td class="px-4 py-3 text-right"><%= row.played %></td>
              <td class="px-4 py-3 text-right"><%= row.wins %></td>
              <td class="px-4 py-3 text-right"><%= row.losses %></td>
              <td class="px-4 py-3 text-right"><%= row.ties %></td>
              <td class="px-4 py-3 text-right"><%= format_points(row.points_for) %></td>
              <td class="px-4 py-3 text-right"><%= format_points(row.points_against) %></td>
              <td class="px-4 py-3 text-right"><%= standings_diff(row.diff) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <p class="text-sm text-gray-500">
      <%= t('standings.show.footnote', bonus: format_points(@season.sweep_bonus)) %>
    </p>
  <% else %>
    <p class="text-gray-500"><%= t('standings.show.empty') %></p>
  <% end %>
</div>
